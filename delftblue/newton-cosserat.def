# Apptainer image for running newton-cosserat on the TU Delft DelftBlue cluster.
#
# Built on a DelftBlue LOGIN node with --fakeroot (no Docker needed); see
# delftblue/README.md. Build with delftblue/build_sif.sh, which runs from the
# newton-cosserat checkout because the %files paths below are relative to it.
#
# Unlike the DAIC image, this one installs the locked `cuda13` extra unchanged:
# DelftBlue's NVIDIA driver (615, CUDA 13.4) runs the CUDA 13 JAX plugin. PyTorch and
# the packages only it needs are skipped; the benchmark never imports them.
#
# The source tree copied here is only used to create the editable install. At run time
# the live checkout is bind-mounted over /workspace/newton-cosserat, so code changes
# need no rebuild; rebuild only when uv.lock changes.

Bootstrap: docker
# Debian bookworm with git, curl and CA certificates (git fetches Newton/SoRoMoX and
# records the benchmark revision).
From: buildpack-deps:bookworm-scm

%files
    pyproject.toml /workspace/newton-cosserat/pyproject.toml
    uv.lock /workspace/newton-cosserat/uv.lock
    README.md /workspace/newton-cosserat/README.md
    src /workspace/newton-cosserat/src

%post -c /bin/bash
    set -euo pipefail
    UV_VERSION=0.12.3
    PYTHON_VERSION=3.13
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_PREFERENCE=only-managed \
        UV_PROJECT_ENVIRONMENT=/opt/venv VIRTUAL_ENV=/opt/venv \
        UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_NO_CACHE=1

    curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" \
        | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    # The bind-mounted checkout is owned by the host user, not the build's fake root.
    git config --system --add safe.directory '*'

    cd /workspace/newton-cosserat
    rm -rf src/newton_cosserat.egg-info $(find src -name __pycache__ -type d)
    uv python install "${PYTHON_VERSION}"
    uv sync --locked --no-dev --extra cuda13 --extra viz --python "${PYTHON_VERSION}" \
        --no-install-package torch --no-install-package triton --no-install-package nvidia-cusparselt-cu13

    uv pip freeze | sort > /opt/venv-freeze.txt
    # Jobs compare this with the checkout's uv.lock and warn when the image is stale.
    sha256sum uv.lock | cut -d' ' -f1 > /opt/uv.lock.sha256
    # No GPU at build time: keep JAX off CUDA so the import check does not print plugin errors.
    JAX_PLATFORMS=cpu /opt/venv/bin/python -c "import newton_cosserat.solvers, newton, warp, jax, soromox, matplotlib; print('imports ok')"

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:${PATH}
    export XLA_PYTHON_CLIENT_PREALLOCATE=false
    export PYTHONUNBUFFERED=1

%runscript
    exec python "$@"

%help
    newton-cosserat dependencies (uv.lock with the cuda13 and viz extras, no torch).
    Run through delftblue/env.sh (nc_exec) from newton-cosserat-cluster, which mounts the checkout,
    the GPU (--nv) and the Warp/JAX caches. Installed packages: /opt/venv-freeze.txt.
